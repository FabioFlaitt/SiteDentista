# Frontend — valores PÚBLICOS, substituídos em tempo de build.
# No Angular, variáveis são lidas via src/environments/*.ts (não process.env).
# Este arquivo documenta quais chaves preencher no painel da Vercel.

NG_APP_API_BASE_URL=http://localhost:5080
NG_APP_SITE_URL=http://localhost:4200
NG_APP_ENABLE_VERCEL_ANALYTICS=false
