# ============================================
# Variáveis compartilhadas do monorepositório
# ============================================
# Copie este arquivo para `.env` e preencha com valores locais.
# Nunca comite `.env` no git.

# --------------------------------------------
# Frontend (público — exposto ao navegador)
# --------------------------------------------
# URL base da API consumida pelo frontend em produção
NG_APP_API_BASE_URL=https://api.drabrunamolina.com.br

# URL canônica do site (sem barra final)
NG_APP_SITE_URL=https://www.drabrunamolina.com.br

# Opcional: habilita Vercel Web Analytics
NG_APP_ENABLE_VERCEL_ANALYTICS=false

# --------------------------------------------
# Backend (NUNCA exposto ao navegador)
# --------------------------------------------
# PostgreSQL
ConnectionStrings__Default=Host=localhost;Port=5432;Database=brunamolina;Username=brunamolina;Password=change-me

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# Origens autorizadas por CORS (separe por vírgula)
Cors__AllowedOrigins=http://localhost:4200,https://www.drabrunamolina.com.br

# Admin seed (apenas para primeiro provisionamento; remova depois)
AdminSeed__Email=admin@drabrunamolina.com.br
AdminSeed__Password=change-me-and-remove-after-first-run

# Chave para proteção adicional de assinatura de cookies/data-protection keys
DataProtection__ApplicationName=BrunaMolina
